<?xml version="1.0" encoding="utf-8"?>
<!--
  掃描取字。SPEC 第 5 節「掃描」的完整節奏：
  即時預覽時就浮現取字框 → 快門後凍結 → 點字選取 → 底部卡片顯示釋義 → 加入 N 個單字。

  即時預覽那段的框<b>只是引導</b>，告訴使用者該拿多近、角度多正，不能點。
  能點的框是快門之後、從那張凍結的靜態圖算出來的 —— 圖跟框來自同一幀，
  不會有「看到的字跟點到的位置對不上」的問題。
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      凍結後顯示的靜態圖。fitCenter 讓 getImageMatrix() 直接給出
      「bitmap 座標 → view 座標」的精確轉換，框就是用它換算的。
    -->
    <ImageView
        android:id="@+id/frozen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.eanki.ui.scan.TextOverlayView
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/stats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_m"
        android:background="@color/nav_bar"
        android:fontFamily="monospace"
        android:paddingStart="@dimen/spacing_m"
        android:paddingTop="@dimen/spacing_s"
        android:paddingEnd="@dimen/spacing_m"
        android:paddingBottom="@dimen/spacing_s"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="辨識 9.4 fps · 平均 185 ms · 16 個字" />

    <!-- 點到的字的釋義。SPEC 第 5 節「底部卡片顯示釋義」。 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/wordCard"
        style="@style/Widget.Eanki.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"
        android:layout_marginBottom="@dimen/spacing_s"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_m">

            <TextView
                android:id="@+id/cardHeadword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Eanki.Headword"
                tools:text="dictionary" />

            <TextView
                android:id="@+id/cardInflection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Eanki.Caption"
                android:textColor="@color/mint"
                android:visibility="gone"
                tools:text="jump 的變化形"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/cardPhonetic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Eanki.Phonetic"
                tools:text="/'dikʃənəri/" />

            <TextView
                android:id="@+id/cardTranslation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:ellipsize="end"
                android:maxLines="3"
                android:textAppearance="@style/TextAppearance.Eanki.Body"
                tools:text="n. 字典, 詞典" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"
        android:layout_marginBottom="@dimen/spacing_s"
        android:background="@color/nav_bar"
        android:gravity="center"
        android:padding="@dimen/spacing_s"
        android:text="@string/scan_hint_live"
        android:textAppearance="@style/TextAppearance.Eanki.Caption"
        app:layout_constraintBottom_toTopOf="@id/chipScroll"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
      已選 chip 列。SPEC 第 5 節「掃描」的正式要件。
      選的字一多，框可能捲出畫面外或被其他框擋住，
      chip 列讓使用者一眼看到自己選了什麼，也提供取消的入口。
      橫向捲動、固定在「加入 N 個單字」上方。
    -->
    <HorizontalScrollView
        android:id="@+id/chipScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"
        android:layout_marginBottom="@dimen/spacing_s"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/actionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true" />

    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"
        android:layout_marginBottom="@dimen/spacing_l"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            style="@style/Widget.Eanki.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_close" />

        <Space
            android:layout_width="@dimen/spacing_s"
            android:layout_height="1dp" />

        <!--
          相簿。跟快門並列 —— 同一條辨識管線的另一種輸入源，
          相片就是「已經凍結的畫面」。
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGallery"
            style="@style/Widget.Eanki.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_gallery"
            app:icon="@drawable/ic_gallery" />

        <Space
            android:id="@+id/galleryGap"
            android:layout_width="@dimen/spacing_s"
            android:layout_height="1dp" />

        <!-- 快門。磚紅是 SPEC 第 4 節指定給相機的顏色。 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShutter"
            style="@style/Widget.Eanki.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/brick"
            android:textColor="@color/on_brick"
            android:text="@string/scan_shutter"
            app:icon="@drawable/ic_camera"
            app:iconTint="@color/on_brick" />

        <!-- 凍結後：重拍 / 加入 N 個單字 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetake"
            style="@style/Widget.Eanki.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_retake"
            android:visibility="gone"
            tools:visibility="visible" />

        <Space
            android:id="@+id/actionGap"
            android:layout_width="@dimen/spacing_s"
            android:layout_height="1dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            style="@style/Widget.Eanki.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/scan_add_none"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/busy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/mint"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/permissionState"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/ground"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_need_camera"
            android:textAppearance="@style/TextAppearance.Eanki.Headword" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:gravity="center"
            android:text="@string/scan_need_camera_sub"
            android:textAppearance="@style/TextAppearance.Eanki.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrant"
            style="@style/Widget.Eanki.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l"
            android:text="@string/scan_grant" />

        <!-- 沒給相機權限也還能從相簿取字，不必為了看一張圖而交出相機 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGalleryNoPermission"
            style="@style/Widget.Eanki.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="@string/scan_gallery"
            app:icon="@drawable/ic_gallery" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
