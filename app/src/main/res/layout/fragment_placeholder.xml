<?xml version="1.0" encoding="utf-8"?>
<!-- 熟悉度與設定兩個分頁的預留畫面，內容在 Phase 4 才做 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/gutter"
    android:paddingEnd="@dimen/gutter">

    <TextView
        android:id="@+id/placeholderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Eanki.Headword"
        tools:text="熟悉度" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_s"
        android:text="@string/coming_soon"
        android:textAppearance="@style/TextAppearance.Eanki.Label"
        android:textColor="@color/mint" />

    <TextView
        android:id="@+id/placeholderBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_m"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Eanki.Caption"
        tools:text="熟悉度統計與加強複習會在 Phase 4 完成" />

</LinearLayout>
