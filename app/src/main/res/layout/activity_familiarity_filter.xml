<?xml version="1.0" encoding="utf-8"?>
<!--
  熟悉度篩選。SPEC 第 5 節：從熟悉度某一級點進來，
  可切換級別、排序、逐列 checkbox 多選、每列顯示最近三次評分小點、
  底部「已選 N 個 → 開始加強複習」。
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/gutter"
            android:paddingTop="@dimen/spacing_l"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/spacing_m"
            android:text="@string/filter_title"
            android:textAppearance="@style/TextAppearance.Eanki.Display" />

        <!-- 級別切換。橫向捲動，窄螢幕不會把第四個擠掉。 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/levelChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:selectionRequired="true"
                app:singleSelection="true" />

        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/gutter"
            android:paddingTop="@dimen/spacing_s"
            android:paddingEnd="@dimen/gutter">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSort"
                style="@style/Widget.Eanki.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="最久沒複習" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectAll"
                style="@style/Widget.Eanki.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_select_all" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/spacing_m"
            tools:listitem="@layout/item_filter_word" />

        <TextView
            android:id="@+id/emptyNote"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:text="@string/filter_empty"
            android:textAppearance="@style/TextAppearance.Eanki.Label"
            android:visibility="gone"
            tools:visibility="gone" />

        <!-- 底部列：已選 N 個 → 開始加強複習 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/gutter"
            android:paddingTop="@dimen/spacing_m"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="@dimen/spacing_m">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/selectedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Eanki.Label"
                    tools:text="已選 18 個" />

                <!-- SPEC 第 6.6 節要求 UI 上明寫這句 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/practice_no_schedule"
                    android:textAppearance="@style/TextAppearance.Eanki.Caption" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                style="@style/Widget.Eanki.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:text="@string/practice_start" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
